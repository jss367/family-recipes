---
import { X } from '@lucide/astro';
---

<dialog id="weekly-menu" class="menu-drawer" aria-labelledby="drawer-heading">
	<div class="drawer-inner">
		<div class="drawer-header">
			<div>
				<h2 id="drawer-heading">This week’s menu</h2>
				<p class="helper-text"><span data-menu-count>0 recipes</span> · <span data-storage-note>Saved in this browser.</span></p>
			</div>
			<button id="close-menu" class="icon-button" type="button" aria-label="Close menu"><X size={20} aria-hidden="true" /></button>
		</div>
		<section aria-labelledby="menu-heading">
			<div class="section-heading"><h3 id="menu-heading">On the menu</h3><button id="clear-menu" class="text-button" type="button" hidden>Clear menu</button></div>
			<p id="menu-empty" class="helper-text">Use “Add to menu” on any recipe to start planning your week. We’ll bring their ingredients together in one grocery list.</p>
			<ul id="menu-list" class="menu-list"></ul>
		</section>
		<section aria-labelledby="grocery-heading">
			<div class="section-heading"><h3 id="grocery-heading">Grocery list</h3><span id="grocery-count" class="helper-text" aria-live="polite"></span></div>
			<p id="grocery-empty" class="helper-text">Your combined grocery checklist will appear here.</p>
			<div id="grocery-tools" hidden>
				<p class="helper-text">Check off what you have or buy. Quantities cover each recipe’s listed servings; tap recipe details to see the original amounts.</p>
				<div class="grocery-actions">
					<button id="check-pantry" class="secondary-button" type="button">Check off pantry matches</button>
					<button id="copy-groceries" class="secondary-button" type="button">Copy remaining list</button>
					<button id="reset-checks" class="text-button" type="button">Uncheck all</button>
				</div>
			</div>
			<ul id="grocery-list" class="grocery-list"></ul>
		</section>
	</div>
</dialog>
