---
import { Carrot, Search, X } from '@lucide/astro';
import { getCollection } from 'astro:content';
import RecipeCard from '../components/RecipeCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import KitchenPlanner from '../components/KitchenPlanner.astro';

const recipes = (await getCollection('recipes')).sort(
	(a, b) => b.data.dateAdded.valueOf() - a.data.dateAdded.valueOf(),
);
const categories = [...new Set(recipes.map((recipe) => recipe.data.category))].sort();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const plannerRecipes = recipes.map(({ id, data }) => ({
	id, title: data.title, servings: data.servings, ingredients: data.ingredients, url: `${base}/recipes/${id}/`,
}));
---

<BaseLayout>
	<section class="catalog-band">
		<div class="shell">
			<div class="catalog-heading"><h1>Find something good</h1><p id="match-status" class="helper-text" role="status"></p></div>
			<div class="catalog-tools">
				<label class="search-box">
					<Search size={19} aria-hidden="true" />
					<span class="sr-only">Search recipes</span>
					<input id="recipe-search" type="search" placeholder="Search recipes or ingredients" autocomplete="off" />
				</label>
				<form id="pantry-form" class="search-box pantry-box">
					<Carrot size={19} aria-hidden="true" />
					<label for="pantry-input" class="sr-only">Ingredients you have</label>
					<input id="pantry-input" type="text" placeholder="I have… tofu, rice, peppers" aria-describedby="pantry-help" autocomplete="off" enterkeyhint="search" />
					<button id="clear-pantry" class="icon-button" type="button" aria-label="Clear pantry" hidden><X size={17} aria-hidden="true" /></button>
					<button class="primary-button" type="submit">Match</button>
				</form>
				<p id="pantry-help" class="helper-text pantry-help">Separate ingredients with commas. Matches check ingredients, not quantities. Water and optional extras don’t count.</p>
				<div class="filters" aria-label="Filter by category">
					<button class="filter-button active" type="button" data-category="all" aria-pressed="true">All recipes</button>
					{categories.map((category) => (
						<button class="filter-button" type="button" data-category={category.toLowerCase()} aria-pressed="false">{category}</button>
					))}
				</div>
			</div>
			<p id="planner-status" class="helper-text" role="status"></p>
			<noscript><p>Enable JavaScript to match pantry ingredients and save a weekly menu. You can still browse and print every recipe.</p></noscript>

			<div class="recipe-grid" id="recipe-grid">
				{recipes.map((recipe) => <RecipeCard recipe={recipe} />)}
			</div>
			<p class="empty-state" id="empty-state" hidden>No recipes match that search.</p>
		</div>
	</section>
	<KitchenPlanner />

	<script is:inline id="planner-data" type="application/json" set:html={JSON.stringify(plannerRecipes).replace(/</g, '\\u003c')} />
	<script>import '../scripts/kitchen-planner';</script>
</BaseLayout>
